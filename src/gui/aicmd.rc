#include <windows.h>
#include "aicmd_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION AICMD_VERSION_MAJOR, AICMD_VERSION_MINOR, AICMD_VERSION_PATCH, 0
PRODUCTVERSION AICMD_VERSION_MAJOR, AICMD_VERSION_MINOR, AICMD_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "aicmd"
            VALUE "FileDescription", "aicmd compact keyboard-first file commander"
            VALUE "FileVersion", AICMD_VERSION_STRING
            VALUE "ProductName", "aicmd"
            VALUE "ProductVersion", AICMD_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
1 RT_MANIFEST "aicmd.manifest"
// First icon resource: used by Explorer, the taskbar and the window class.
100 ICON "aicmd.ico"

2001 DIALOGEX 0, 0, 250, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select files"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Mask (* and ?; separate masks with semicolons):", -1, 8, 8, 234, 12
    EDITTEXT 2002, 8, 23, 234, 14, ES_AUTOHSCROLL
    CONTROL "Include directories", 2003, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 44, 120, 12
    DEFPUSHBUTTON "OK", IDOK, 136, 68, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 192, 68, 50, 14
END

2010 DIALOGEX 0, 0, 260, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 2011, 8, 8, 244, 12, SS_PATHELLIPSIS
    EDITTEXT 2012, 8, 23, 244, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 146, 48, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 202, 48, 50, 14
END

2020 DIALOGEX 0, 0, 300, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search - Alt+F7"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Search in (folder or ssh://alias/path):", -1, 8, 6, 284, 10
    EDITTEXT 2021, 8, 17, 284, 14, ES_AUTOHSCROLL
    LTEXT "File name mask (* and ?; separate masks with semicolons):", -1, 8, 35, 284, 10
    EDITTEXT 2022, 8, 46, 284, 14, ES_AUTOHSCROLL
    LTEXT "Containing text (optional, case-insensitive):", -1, 8, 64, 284, 10
    EDITTEXT 2023, 8, 75, 284, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Search", IDOK, 186, 94, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 242, 94, 50, 14
END
