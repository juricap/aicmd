#include <windows.h>
1 RT_MANIFEST "aicmd.manifest"

2001 DIALOGEX 0, 0, 250, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select files"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Mask (* and ?; separate masks with semicolons):", -1, 8, 8, 234, 12
    EDITTEXT 2002, 8, 23, 234, 14, ES_AUTOHSCROLL
    CONTROL "Include directories", 2003, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 44, 120, 12
    DEFPUSHBUTTON "OK", IDOK, 136, 68, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 192, 68, 50, 14
END
